{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u1-doctor.invalid/schemas/finding.schema.json",
  "title": "U1 Doctor Finding",
  "description": "Explainable conclusion. CONFIRMED_BY_PROTOCOL requires a recorded, reviewed protocol reference. No probability score field exists by design.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_id", "ruleset_id", "ruleset_hash", "rule_id", "rule_version", "classification", "human_title", "hypotheses", "evidence_for", "evidence_against", "missing_data", "firmware_scope", "safe_actions", "references", "limits", "source_mix", "evidence_quality", "replay_hash"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "finding_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
    "ruleset_id": {"type": "string"},
    "ruleset_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rule_id": {"type": "string", "pattern": "^U1-[A-Z0-9-]{3,64}$"},
    "rule_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "classification": {"enum": ["OBSERVED", "SUSPECTED", "INCONCLUSIVE", "NOT_APPLICABLE", "REFUTED", "CONFIRMED_BY_PROTOCOL"]},
    "human_title": {"type": "string", "minLength": 1, "maxLength": 200},
    "not_a_root_cause": {"type": "boolean"},
    "hypotheses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "text", "label"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "label": {"enum": ["OFFICIAL_REFERENCE", "COMMUNITY_HYPOTHESIS", "ENGINE_INFERENCE"]}}}},
    "evidence_for": {"$ref": "#/$defs/evidenceList"},
    "evidence_against": {"$ref": "#/$defs/evidenceList"},
    "missing_data": {"type": "array", "items": {"type": "string"}},
    "firmware_scope": {"type": "array", "items": {"type": "string"}},
    "safe_actions": {"type": "array", "items": {"type": "string"}},
    "references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "url", "checked_at"], "properties": {"kind": {"enum": ["OFFICIAL_WIKI", "OFFICIAL_RELEASE_NOTES", "OFFICIAL_SOURCE", "COMMUNITY_THREAD", "INTERNAL_VALIDATION"]}, "url": {"type": "string", "pattern": "^https://"}, "checked_at": {"type": "string", "format": "date"}}}},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_mix": {"type": "array", "items": {"enum": ["REAL", "SYNTHETIC", "USER_REPORTED", "IMPORTED"]}},
    "evidence_quality": {"enum": ["STRONG", "MODERATE", "WEAK", "UNKNOWN"]},
    "replay_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "format": "date-time", "description": "Metadata. EXCLUDED from replay_hash."},
    "protocol_ref": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"classification": {"const": "CONFIRMED_BY_PROTOCOL"}}, "required": ["classification"]}, "then": {"required": ["protocol_ref"]}},
    {"if": {"properties": {"classification": {"const": "SUSPECTED"}}, "required": ["classification"]}, "then": {"properties": {"evidence_for": {"minItems": 1}}}}
  ],
  "$defs": {
    "evidenceList": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "note"], "properties": {"observation_id": {"type": "string"}, "note": {"type": "string"}}}}
  }
}
