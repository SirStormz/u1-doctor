{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SirStormz/u1-doctor/main/schemas/community-causes.schema.json",
  "title": "U1 Doctor community-reported causes",
  "description": "Causes reported by owners on the public forum, attached to error codes. Always a community report with its source, never official, never an observation. No score, probability or rank field exists by design.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checked_at", "kind", "note", "codes_not_in_catalog", "causes"],
  "$defs": {
    "code": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{4}$"},
    "date": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]-[0-3][0-9]$"},
    "l10n": {"type": "object", "additionalProperties": false, "required": ["en", "fr"], "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 600}, "fr": {"type": "string", "minLength": 1, "maxLength": 700}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["url", "title", "posted"], "properties": {"url": {"type": "string", "pattern": "^https://forum\\.snapmaker\\.com/t/[0-9]+$"}, "title": {"type": "string", "minLength": 1}, "posted": {"$ref": "#/$defs/date"}}},
    "article": {"type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": {"title": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^https://wiki\\.snapmaker\\.com/en/snapmaker_u1/"}}}
  },
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "checked_at": {"$ref": "#/$defs/date"},
    "kind": {"const": "COMMUNITY_REPORT"},
    "note": {"type": "string", "minLength": 1},
    "codes_not_in_catalog": {"type": "array", "items": {"$ref": "#/$defs/code"}, "uniqueItems": true},
    "causes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "codes", "reported_as", "cause", "check", "scope", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^CC-[A-Z0-9-]+$"},
          "codes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/code"}, "uniqueItems": true},
          "reported_as": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 32}},
          "cause": {"$ref": "#/$defs/l10n"},
          "check": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/l10n"}},
          "scope": {"$ref": "#/$defs/l10n"},
          "articles": {"type": "array", "items": {"$ref": "#/$defs/article"}},
          "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
        }
      }
    }
  }
}
