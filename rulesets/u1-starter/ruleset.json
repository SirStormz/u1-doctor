{
  "ruleset_id": "u1-starter",
  "version": "0.5.0",
  "format": "u1-ruleset/1",
  "note": "Declarative parameters only; evaluators are a fixed built-in enum. No code, no expressions. Status PROPOSED: nothing here is hardware-verified.",
  "rules": [
    {"id": "U1-S01-CODE-DECODE", "version": "1.0.0", "status": "PROPOSED", "evaluator": "catalog_code", "params": {"event_type": "user_reported_error_code"}},
    {"id": "U1-S03-STATE-TRANSITION", "version": "1.0.0", "status": "PROPOSED", "evaluator": "state_transition", "params": {"event_type": "state_transition", "from": "printing", "to": ["paused", "error"], "proximity_s": 120}},
    {"id": "U1-S09-MAPPING-UNKNOWN", "version": "1.0.0", "status": "PROPOSED", "evaluator": "mapping_unknown", "params": {"skip_event_types": ["cloud_mqtt_offline", "moonraker_summary", "klippy_link_stats", "klippy_summary", "klippy_shutdown", "unisrv_summary", "syslog_summary", "gui_summary", "mosquitto_summary", "orca_summary", "firmware_upgrade", "encrypted_system_log", "log_file_seen"]}},
    {"id": "U1-S10-OBSERVATION-GAPS", "version": "1.0.0", "status": "PROPOSED", "evaluator": "coverage_gaps", "params": {"event_types": ["capture_gap", "connection_timeout", "connection_lost"]}},
    {"id": "U1-SEC-BLOCKED-CALL", "version": "1.0.0", "status": "PROPOSED", "evaluator": "transport_denied", "params": {"event_type": "transport_denied"}},
    {"id": "U1-S11-BED-WINDOW", "version": "1.0.0", "status": "PROPOSED", "evaluator": "value_window", "params": {"event_types": ["bed_temperature_sample"], "field": "celsius", "min": -10, "max": 110, "label": "Heated bed temperature", "code": "0003-0526-0000-0000", "hypothesis": "The official page gives -10 to 110 degC as the normal bed range and lists wiring and sensor checks when it is left", "reference_url": "https://wiki.snapmaker.com/en/snapmaker_u1/troubleshooting/bed_temperature_exceeds_limit"}},
    {"id": "U1-S12-NOZZLE-WINDOW", "version": "1.0.0", "status": "PROPOSED", "evaluator": "value_window", "params": {"event_types": ["temperature_sample", "extruder_temperature"], "field": "celsius", "min": -10, "max": 310, "label": "Nozzle temperature", "hypothesis": "The official page gives -10 degC as the minimum and 310 degC as the maximum safe nozzle temperature and lists heater and sensor checks", "reference_url": "https://wiki.snapmaker.com/en/snapmaker_u1/troubleshooting/nozzle_temperature_anomaly"}},
    {"id": "U1-S13-CODE-RECURRENCE", "version": "1.0.0", "status": "PROPOSED", "evaluator": "code_recurrence", "params": {"event_type": "user_reported_error_code", "min_count": 3, "window_s": 900}},
    {"id": "U1-S14-CONNECTION-FLAPS", "version": "1.0.0", "status": "PROPOSED", "evaluator": "connection_flaps", "params": {"event_types": ["connection_lost", "connection_timeout"], "min_count": 3, "window_s": 600, "hypothesis": "The official static-IP page says a printer that often disconnects, looks offline or loses pairing may have changed address after a restart", "reference_url": "https://wiki.snapmaker.com/en/snapmaker_u1/set-static-ip-for-u1"}},
    {"id": "U1-S15-DRYRUN-PREDICTION", "version": "1.0.0", "status": "PROPOSED", "evaluator": "dryrun_prediction", "params": {"declared_event_type": "user_reported_error_code", "hypothesis": "The community tool U1 Dry Run replays the sliced file on the firmware motion code and reports the moves the firmware would refuse and the tool-change travel that would leave scars on the print; it is a simulation and models no heating, flow or sensors", "reference_url": "https://github.com/DesignMaster-Solutions/u1-dryrun"}},
    {"id": "U1-S04-DROP-PROBE", "version": "1.0.0", "status": "PROPOSED", "evaluator": "drop_probe", "params": {"drop_event_types": ["connection_lost", "connection_timeout"], "probe_event_type": "link_probe", "window_s": 120}},
    {"id": "U1-S16-FAN-OFF-HOT", "version": "1.0.0", "status": "PROPOSED", "evaluator": "fan_off_hot", "params": {"event_type": "nozzle_fan_sample", "min_celsius": 60, "min_count": 3}},
    {"id": "U1-S17-OFFSET-Y-SPREAD", "version": "1.0.0", "status": "PROPOSED", "evaluator": "offset_spread", "params": {"event_type": "extruder_offsets", "coverage_keys": ["extruder_offset"], "label": "Toolhead offsets", "axis": "y", "max_spread_mm": 2.0, "low_mm": -1.0, "hypothesis": "One forum report: the stock start line G0 X85 Y1 failed with Move out of range on Y whenever the starting head had a Y offset below about -1.0 mm, on a printer whose Y offsets spread over 2.26 mm", "reference_url": "https://forum.snapmaker.com/t/44046"}},
    {"id": "U1-S18-SENSOR-IMPLAUSIBLE", "version": "1.0.0", "status": "PROPOSED", "evaluator": "sensor_implausible", "params": {"event_type": "heater_window", "coverage_keys": ["heater_bed", "temperature_sensor cavity"], "label": "Bed and cavity temperatures", "sensors": ["heater_bed", "temperature_sensor cavity"], "below_c": -100, "min_pairs": 3, "hypothesis": "One resolved forum report: bed and chamber both read about -1035.8 degC (ADC out of range) and the cause was debris in a feeder ribbon-cable connector, not the bed", "reference_url": "https://forum.snapmaker.com/t/44067"}},
    {"id": "U1-S19-HEATER-NO-RISE", "version": "1.0.0", "status": "PROPOSED", "evaluator": "heater_no_rise", "params": {"event_type": "heater_window", "coverage_keys": ["heater_bed"], "label": "Heater temperatures", "min_window_s": 30, "min_gap_c": 10, "min_rise_c": 2}},
    {"id": "U1-S20-NOZZLE-DIAMETER", "version": "1.0.0", "status": "PROPOSED", "evaluator": "nozzle_compare", "params": {"event_type": "nozzle_diameters", "gcode_event_type": "gcode_nozzle_diameter", "coverage_keys": ["nozzle_diameter"], "label": "Nozzle diameters", "hypothesis": "One forum report: Fluidd showed 0.4 mm for a head while 0.2 mm nozzles were set in the printer menu, and the nozzle later slipped during loading", "reference_url": "https://forum.snapmaker.com/t/43566"}},
    {"id": "U1-S21-CLOCK-RESET", "version": "1.0.0", "status": "PROPOSED", "evaluator": "clock_gap", "params": {"event_type": "clock_check", "coverage_keys": ["estimated_print_time"], "label": "Controller and host clocks", "states": ["printing"], "min_gap_s": 600, "hypothesis": "One forum report on firmware 1.1.0: after Klipper was restarted without a full power cycle, the touchscreen went blank during the next print; a full power cycle cleared it", "reference_url": "https://forum.snapmaker.com/t/41112"}},
    {"id": "U1-S22-LOG-PARTITION", "version": "1.0.0", "status": "PROPOSED", "evaluator": "disk_usage", "params": {"event_type": "disk_usage", "coverage_keys": ["disk_usage"], "label": "Log partition usage", "hypothesis": "One forum report: logs and configuration share a 100 MB partition by default, logs rotate after one or two prints, and support gave no size limit", "reference_url": "https://forum.snapmaker.com/t/41445"}},
    {"id": "U1-S23-TOOLHEAD-ACTIVITY", "version": "1.0.0", "status": "PROPOSED", "evaluator": "extruder_activity", "params": {"event_type": "extruder_activity", "coverage_keys": ["extruder_state"], "label": "Toolhead activity counters"}},
    {"id": "U1-S24-BED-MESH-STATS", "version": "1.0.0", "status": "PROPOSED", "evaluator": "bed_mesh_stats", "params": {"event_type": "bed_mesh_points", "coverage_keys": ["bed_mesh"], "label": "Bed mesh"}},
    {"id": "U1-S25-MACHINE-EXCEPTIONS", "version": "1.0.0", "status": "PROPOSED", "evaluator": "machine_exceptions", "params": {}},
    {"id": "U1-S26-LINK-HEALTH", "version": "1.0.0", "status": "PROPOSED", "evaluator": "link_health", "params": {}},
    {"id": "U1-S27-KLIPPY-SHUTDOWN", "version": "1.0.0", "status": "PROPOSED", "evaluator": "klippy_shutdowns", "params": {}},
    {"id": "U1-S28-NETWORK-HEALTH", "version": "1.0.0", "status": "PROPOSED", "evaluator": "network_health", "params": {"min_count": 5, "hypothesis": "The official static-IP page says a printer that often disconnects, looks offline or loses pairing may have changed address after a restart", "reference_url": "https://wiki.snapmaker.com/en/snapmaker_u1/set-static-ip-for-u1"}},
    {"id": "U1-S29-FIRMWARE-UPGRADE", "version": "1.0.0", "status": "PROPOSED", "evaluator": "firmware_upgrade", "params": {}},
    {"id": "U1-S30-TIMELAPSE-FAILURES", "version": "1.0.0", "status": "PROPOSED", "evaluator": "timelapse_failures", "params": {"min_count": 3}},
    {"id": "U1-S31-ORCA-LINK", "version": "1.0.0", "status": "PROPOSED", "evaluator": "orca_link", "params": {"min_count": 5, "min_sync": 50}},
    {"id": "U1-S32-ENCRYPTED-LOG", "version": "1.0.0", "status": "PROPOSED", "evaluator": "encrypted_log", "params": {}}
  ]
}
